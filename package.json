{
  "name": "pi-code",
  "displayName": "Pi Code",
  "description": "VS Code UI for the Pi coding agent",
  "version": "0.6.2",
  "publisher": "Avhatar",
  "license": "MIT",
  "icon": "media/pi-code-icon-full.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pi-code",
          "title": "Pi Code",
          "icon": "media/pi-code-icon.svg"
        }
      ]
    },
    "views": {
      "pi-code": [
        {
          "type": "webview",
          "id": "pi-code.chat",
          "name": ""
        }
      ]
    },
    "commands": [
      {
        "command": "pi-code.newChat",
        "title": "Pi Code: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "pi-code.abort",
        "title": "Pi Code: Stop Generation"
      },
      {
        "command": "pi-code.selectModel",
        "title": "Pi Code: Select Model"
      },
      {
        "command": "pi-code.toggleThinking",
        "title": "Pi Code: Toggle Thinking Level"
      },
      {
        "command": "pi-code.focusChat",
        "title": "Pi Code: Focus Chat"
      },
      {
        "command": "pi-code.openSettings",
        "title": "Pi Code: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "pi-code.showSessions",
        "title": "Pi Code: Session History",
        "icon": "$(history)"
      },
      {
        "command": "pi-code.createTab",
        "title": "Pi Code: New Agent Tab",
        "icon": "$(add)"
      }
    ],
    "keybindings": [
      {
        "command": "pi-code.focusChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      },
      {
        "command": "pi-code.newChat",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n"
      },
      {
        "command": "pi-code.abort",
        "key": "escape",
        "when": "pi-code.isStreaming"
      }
    ],
    "configuration": {
      "title": "Pi Code",
      "properties": {
        "pi-code.apiProvider": {
          "type": "string",
          "default": "",
          "description": "Preferred AI provider (e.g. anthropic, openai, google, deepseek). Leave empty for automatic detection."
        },
        "pi-code.apiBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Custom API base URL for self-hosted or proxy endpoints. Leave empty to use the provider default."
        },
        "pi-code.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Default model ID to use when starting new sessions (e.g. claude-sonnet-4-20250514). Leave empty for automatic selection."
        },
        "pi-code.thinkingLevel": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "minimal",
            "low",
            "medium",
            "high"
          ],
          "description": "Default thinking level for Pi Code responses"
        },
        "pi-code.autoApproveTools": {
          "type": "boolean",
          "default": false,
          "description": "Automatically approve tool executions without confirmation"
        },
        "pi-code.allowedTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Restrict which tools the agent can use. Leave empty to allow all tools."
        },
        "pi-code.autoSaveSessions": {
          "type": "boolean",
          "default": true,
          "description": "Automatically persist sessions"
        },
        "pi-code.sessionStoragePath": {
          "type": "string",
          "default": "",
          "description": "Custom path for session storage. Leave empty to use the default workspace .pi/ directory."
        },
        "pi-code.contextUsageWarningThreshold": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "maximum": 100,
          "description": "Show a warning when context usage exceeds this percentage of the context window"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npx @vscode/vsce package --allow-missing-repository --no-rewrite-relative-links",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "node out/test/integration/runTest.js",
    "test:all": "npm run test:unit && npm run test:integration",
    "version:patch": "node scripts/bump-version.js patch --sync-lock",
    "version:minor": "node scripts/bump-version.js minor --sync-lock",
    "version:major": "node scripts/bump-version.js major --sync-lock",
    "deploy": "npm run compile && npm prune --omit=dev && npm run package && npm install && node -e \"const p=require('./package.json'); require('child_process').execSync('code --install-extension '+p.name+'-'+p.version+'.vsix --force', {stdio:'inherit'})\"",
    "deploy:patch": "npm run version:patch && npm run deploy",
    "deploy:minor": "npm run version:minor && npm run deploy",
    "deploy:major": "npm run version:major && npm run deploy"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.70.2",
    "@mariozechner/pi-coding-agent": "^0.70.2",
    "marked": "^18.0.2",
    "pi-web-access": "^0.10.7"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.0",
    "mocha": "^11.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "author": "Timofei Nikitchenko",
  "repository": {
    "type": "git",
    "url": "https://github.com/Avhatar/pi-vscode-extension-avr.git"
  },
  "bugs": {
    "url": "https://github.com/Avhatar/pi-vscode-extension-avr/issues"
  },
  "homepage": "https://github.com/Avhatar/pi-vscode-extension-avr#readme"
}
